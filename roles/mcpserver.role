# This role runs the MCP server alongside the walk/motion stack, allowing the robot to be controlled via MCP clients.
nuclear_role(
  # FileWatcher, ConsoleLogHandler and Signal Catcher Must Go First and without it many roles do not run
  extension::FileWatcher # Watches configuration files for changes
  support::SignalCatcher # Allows for graceful shutdown
  # Configuration
  actuation::KinematicsConfiguration # Must go early in the role as other modules depend on it
  support::configuration::SoccerConfig # Emits FieldDescription, required by FieldLocalisationNLopt
  # Network
  network::NUClearNet
  network::NetworkForwarder
  network::PlotJuggler
  network::MCPServer
  # Sensors
  input::K1Sensors
  input::K1Camera
  # Director
  extension::Director
  # Servos
  actuation::Servos
  actuation::Kinematics
  actuation::FootController
  # Skills
  skill::K1Walk
  skill::KickWalk
  skill::K1GetUp
  skill::K1Look
  # Planners
  planning::GetUpPlanner
  planning::FallingRelaxPlanner
  planning::PlanWalkPath # Provider for the WalkTo task emitted by strategy::WalkToFieldPosition
  # Localisation
  localisation::FieldLocalisationNLopt
  # Vision
  vision::VisualMesh
  vision::GreenHorizonDetector
  vision::FieldLineDetector
  vision::BallDetector
  vision::Yolo
  # Strategies
  strategy::FallRecovery
  strategy::StandStill
  strategy::WalkToFieldPosition # Provider for the WalkToFieldPosition task emitted by MCPServer
  # Purpose
  purpose::KeyboardWalk
  # Platform
  platform::${SUBCONTROLLER}::HardwareIO
)
